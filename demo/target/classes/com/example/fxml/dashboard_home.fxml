<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.DashboardHomeController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            stylesheets="@../css/styles.css">

    <VBox spacing="24" style="-fx-padding: 8;">

        <!-- Welcome Section -->
        <VBox spacing="6">
            <Label fx:id="lblWelcome" text="Selamat Datang! 👋" styleClass="label-title"/>
            <Label text="Temukan destinasi wisata terbaik di Indonesia" styleClass="label-muted"
                   style="-fx-font-size: 15px;"/>
        </VBox>

        <!-- Filter Chips -->
        <VBox spacing="10">
            <Label text="Kategori" styleClass="label-subtitle"/>
            <HBox fx:id="filterContainer" spacing="8"/>
        </VBox>

        <!-- Top Destinations -->
        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🏆 Top Destinasi" styleClass="label-section"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Lihat Semua" styleClass="btn-outline" onAction="#handleShowAll"
                        style="-fx-padding: 6 16; -fx-font-size: 12px;"/>
            </HBox>

            <FlowPane fx:id="cardContainer" hgap="16" vgap="16" prefWrapLength="900"/>

            <!-- Empty State -->
            <VBox fx:id="emptyState" styleClass="empty-state" spacing="12" visible="false" managed="false">
                <Label text="📭" styleClass="empty-state-icon"/>
                <Label text="Data tidak tersedia" styleClass="empty-state-text"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
