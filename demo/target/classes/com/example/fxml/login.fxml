<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.LoginController"
           styleClass="login-bg" prefWidth="1000" prefHeight="650"
           stylesheets="@../css/styles.css">

    <VBox alignment="CENTER" spacing="0" maxWidth="420">
        <!-- Login Card -->
        <VBox styleClass="login-card" spacing="20" alignment="CENTER">

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="4">
                <Label text="🌴" style="-fx-font-size: 42px;"/>
                <Label text="WisataKu" styleClass="login-logo"/>
                <Label text="Sistem Informasi Wisata" styleClass="login-subtitle"/>
            </VBox>

            <Separator/>

            <!-- Form -->
            <VBox spacing="14">
                <VBox spacing="4">
                    <Label text="Username" styleClass="login-field-label"/>
                    <TextField fx:id="txtUsername" promptText="Masukkan username" prefHeight="40"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Password" styleClass="login-field-label"/>
                    <PasswordField fx:id="txtPassword" promptText="Masukkan password" prefHeight="40"/>
                </VBox>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="lblError" styleClass="label-error" text="" wrapText="true"/>

            <!-- Buttons -->
            <VBox spacing="10" alignment="CENTER">
                <Button fx:id="btnLogin" text="Login" styleClass="btn-primary"
                        onAction="#handleLogin" prefWidth="340" prefHeight="42"/>

                <HBox alignment="CENTER" spacing="4">
                    <Label text="Belum punya akun?" styleClass="label-muted"/>
                    <Button text="Daftar disini" styleClass="link-button" onAction="#handleGoToRegister"/>
                </HBox>

                <Separator/>

                <Button fx:id="btnGuest" text="🔍  Jelajahi sebagai Tamu" styleClass="btn-outline"
                        onAction="#handleGuestMode" prefWidth="340" prefHeight="38"/>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
