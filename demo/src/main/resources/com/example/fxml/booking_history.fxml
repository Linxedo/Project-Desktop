<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.BookingHistoryController"
      spacing="16" style="-fx-padding: 8;" stylesheets="@../css/styles.css">

    <Label text="📋 Riwayat Booking" styleClass="label-title"/>

    <!-- Filter -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Filter Status:" styleClass="form-label"/>
        <ComboBox fx:id="cmbStatus" promptText="Semua" prefWidth="180" onAction="#handleFilter"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tableBooking" VBox.vgrow="ALWAYS" prefHeight="500">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50">
                <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colDestinasi" text="Destinasi" prefWidth="200">
                <cellValueFactory><PropertyValueFactory property="namaWisata"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTanggal" text="Tanggal" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="tglKunjungan"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colJumlah" text="Tiket" prefWidth="70">
                <cellValueFactory><PropertyValueFactory property="jumlahTiket"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTotal" text="Total Harga" prefWidth="140">
                <cellValueFactory><PropertyValueFactory property="formattedTotalHarga"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
            </TableColumn>
        </columns>
        <placeholder>
            <Label text="Belum ada riwayat booking" styleClass="label-muted"/>
        </placeholder>
    </TableView>
</VBox>
