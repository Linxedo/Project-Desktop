<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.RegisterController"
           styleClass="login-bg" prefWidth="1000" prefHeight="650"
           stylesheets="@../css/styles.css">

    <VBox alignment="CENTER" spacing="0" maxWidth="420">
        <VBox styleClass="login-card" spacing="18" alignment="CENTER">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="4">
                <Label text="🌴" style="-fx-font-size: 36px;"/>
                <Label text="Buat Akun Baru" styleClass="login-title"/>
                <Label text="Bergabunglah dengan WisataKu" styleClass="login-subtitle"/>
            </VBox>

            <Separator/>

            <!-- Form -->
            <VBox spacing="12">
                <VBox spacing="4">
                    <Label text="Username" styleClass="login-field-label"/>
                    <TextField fx:id="txtUsername" promptText="Min. 3 karakter (huruf, angka, _)" prefHeight="38"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Email" styleClass="login-field-label"/>
                    <TextField fx:id="txtEmail" promptText="contoh@email.com" prefHeight="38"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Password" styleClass="login-field-label"/>
                    <PasswordField fx:id="txtPassword" promptText="Min. 6 karakter" prefHeight="38"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Konfirmasi Password" styleClass="login-field-label"/>
                    <PasswordField fx:id="txtConfirmPassword" promptText="Ulangi password" prefHeight="38"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Daftar Sebagai" styleClass="login-field-label"/>
                    <ComboBox fx:id="cmbRole" promptText="Pilih role" prefWidth="340" prefHeight="38"/>
                </VBox>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="lblError" styleClass="label-error" text="" wrapText="true"/>

            <!-- Buttons -->
            <VBox spacing="10" alignment="CENTER">
                <Button fx:id="btnRegister" text="Daftar" styleClass="btn-primary"
                        onAction="#handleRegister" prefWidth="340" prefHeight="42"/>

                <HBox alignment="CENTER" spacing="4">
                    <Label text="Sudah punya akun?" styleClass="label-muted"/>
                    <Button text="Login disini" styleClass="link-button" onAction="#handleGoToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
